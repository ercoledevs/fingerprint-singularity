{
  "name": "fingerprint-singularity",
  "version": "0.2.0",
  "description": "Display-independent observations and conservative, explainable candidate matching. No universal device identity guarantee.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./client/agent.d.ts",
      "import": "./client/agent.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "client"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ercoledevs/fingerprint-singularity.git"
  },
  "homepage": "https://github.com/ercoledevs/fingerprint-singularity#readme",
  "bugs": {
    "url": "https://github.com/ercoledevs/fingerprint-singularity/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm test && npm run test:types",
    "test:types": "tsc -p tests/tsconfig.json",
    "test:browser": "npm run build && node scripts/browser-check.mjs",
    "bench": "npm run build && node --expose-gc scripts/benchmark.mjs",
    "demo": "npm run build && node scripts/serve.mjs",
    "prepack": "npm run build",
    "build:console": "npm run build && npm run build --prefix web && node scripts/build-sdk.mjs"
  },
  "devDependencies": {
    "playwright": "1.58.2",
    "typescript": "5.9.3"
  }
}
